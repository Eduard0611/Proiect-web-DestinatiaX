<section id="galerie">





    
    <h2>Galerie Destinații Populare</h2>

    <div id="gr">
    <%
        let minutulCurent= (new  Date()).getMinutes();  
        let sfertCurent= Math.floor(minutulCurent / 15) + 1;

        let contorImagini = 0;

        for(let imag of locals.imagini){

            if (imag.sfert_ora && imag.sfert_ora == sfertCurent) {

                if(contorImagini >= 10)
                    break;

                contorImagini++;
            %>

                <figure>
                    <picture>
                        <source srcset="<%- imag.cale_imagine_medie %>" media="screen and (max-width: 1100px)">
                        <source srcset="<%- imag.cale_imagine_mic %>" media="screen and (max-width: 700px)">
                        <img src="<%- imag.cale_imagine %>" title="<%- imag.titlu %>" alt="<%- imag.titlu %>" width="370" height= "auto" />
                        <figcaption> <%- imag.descriere %> </figcaption>
                    </picture>
                </figure>

            <% } %>
        <% } %>
    </div>










