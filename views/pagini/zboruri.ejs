<!DOCTYPE html>
<html lang="ro">
<head>
    <title>DestinatiaX - Bilete de avion ieftine</title>
    <meta name="keywords" content="bilete de avion, destinatia visurilor, vacanta ieftina, zboruri confortabile, DestinatiaX">
    <meta name="description" content="DestinatiaX oferă cele mai ieftine bilete de avion spre destinatia visurilor tale. Planifică-ți vacanța simplu și rapid.">
    
    <%- include('../fragmente/head.ejs') %>

</head>
<body id="body-zboruri">
    
    <div id="watermark"></div>

    <%- include('../fragmente/header.ejs') %>

    <main>
        <div id="filtre">
            <label> Unde vrei să călatorești: <input type="text" id="inp-nume"></label>

            <label> Suma maximă pusă la saltea pt aceasta vacanță: <input type="number" id="buget-maxim" value="10000"></label>

            <div> Aici se vede cine călătorește cu stil sau nu:<!-- trebuie sa aiba acelasi name ca sa formeze un grup -->
                <p><label>Economy (preț &lt; 100EUR)
                    <input id="i_rad1"  name="gr_rad" value="0:350" type="radio"/>
                </label></p>
                <p><label>Premium Economy (100EUR &le; preț &lt; 250EUR)
                    <input id="i_rad2"  name="gr_rad" value="350:700" type="radio"/>
                </label></p>
                <p><label>Business (250EUR &le; preț &le; 450EUR)
                    <input id="i_rad3" name="gr_rad" value="700:1000000000" type="radio"/>
                </label></p>
                <p><label>First Class (450EUR &le; preț &le; 1000EUR)
                    <input id="i_rad3" name="gr_rad" value="700:1000000000" type="radio"/>
                </label></p>
                <p><label>Toate
                    <input id="i_rad4" checked name="gr_rad" value="toate" type="radio"/>
                </label></p>
            </div>


            <label> Locuri disponibile: <input type="range" id="inp-pret" value="0" min="0"  max="70"> <span id="infoRange">(0)</span></label>
            <label>Select simplu:
                <select id="inp-categorie">
                    <option id="sel-toate" selected value="toate">toate</option>
                    <% for (let opt of locals.optiuni) { %>
                        <option value="<%- opt.unnest %>"><%- opt.unnest %> </option>
                    <% } %>
                </select>
            </label>
       
            <p>
            <button class="c1 c2 c3" id="filtrare">Filtreaza</button> 

            <button id="resetare">Reseteaza</button><br/>
            <button id="sortCrescNume">Sorteaza crescator dupa pret si nume</button>
            <button id="sortDescrescNume">Sorteaza descrescator dupa pret si nume</button>

            </p>
        
            <p id="p-suma">Apăsați Alt+"c" pentru suma preturilor produselor afișate. </p>

        </div>
        <section id="produse">

            <h2>Zboruri</h2>
                <div>
                    <% for( let zbor of locals.zboruri) { %>
                        <a class="link-fara-stilizare" href="/zbor/<%-zbor.id %>">
                            <article class="produs-zbor">
                                <div class="zona-plecare">
                                    <span class="oras"><%- zbor.oras_plecare %> <i class="fa-solid fa-plane-departure"></i></span>
                                    <span class="data"><%- new Date(zbor.data_plecare).toLocaleString('ro-RO') %></span>
                                </div>

                                <div class="zona-centrala">
                                    <h3 class="titlu-zbor"><%- zbor.titlu_zbor %></h3>
                                    <figure class="container-imagine">
                                        <img src="/resurse/imagini/zboruri/<%- zbor.imagine %>" alt="[imagine <%- zbor.titlu_zbor %>]" />
                                    </figure>
                                    <div class="pret-zbor"><%- zbor.pret %> EUR</div>
                                </div>

                                <div class="zona-sosire">
                                    <span class="oras"><i class="fa-solid fa-plane-arrival"></i> <%- zbor.oras_sosire %></span>
                                    <span class="data"><%- new Date(zbor.data_sosire).toLocaleString('ro-RO') %></span>
                                </div>

                                <input type="checkbox" class="select-cos" value="<%-zbor.id %>">
                            </article>
                        <% }%>
                    </a>
                </div>
        </section>
    </main>
        
    <%- include('../fragmente/footer.ejs') %>

</body>
</html>